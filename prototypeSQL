@bot.message_handler(content_types=['location'])
def otvet_location(message):
    lat = float(message.location.latitude)
    lon = float(message.location.longitude)

    url = "https://api.open-meteo.com/v1/forecast"
    params = {
        "latitude": lat,
        "longitude": lon,
        "current": "relative_humidity_2m,wind_speed_10m,wind_direction_10m,wind_gusts_10m,precipitation,snowfall,rain",
        "timezone": "auto",
    }
    response = requests.get(url, params=params, timeout=15)
    weather_data = response.json()["current"]

    temp = weather_data.get('temperature_2m', 'хз')
    humidity = weather_data.get('relative_humidity_2m', 'хз')
    wind_speed = weather_data.get('wind_speed_10m', 'хз')
    wind_dir = weather_data.get('wind_direction_10m', 'хз')
    wind_gust = weather_data.get('wind_gusts_10m', 'хз')
    precipitation = weather_data.get('precipitation', 'хз')
    snowfall = weather_data.get('snowfall', 'хз')
    rain = weather_data.get('rain', 'хз')

    wind_data = wind_data = f"""
    Погода:
Температура: {temp}°C
Влажность: {humidity}%

    Ветер:
Скорость: {wind_speed} м/с
Направление: {wind_dir}°
Порывы: {wind_gust} м/с

   Осадки:
Дождь: {rain} мм
Снег: {snowfall} см
Всего: {precipitation} мм"""

    bot.send_message(message.chat.id, wind_data)

